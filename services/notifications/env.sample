# Kumoss notifications service — environment variables.
#
# Copy to ./services/notifications/.env (gitignored). The notifications
# service's env_file: in docker-compose.yml points here.

# Bearer token clients must present. MUST match KUMOSS_NOTIFICATIONS_TOKEN
# in core/.env. Empty disables auth on the service side; the core's
# config.yaml is the source of truth for whether a token is required
# (the core refuses to boot if services.notifications.enabled=true but
# the resolved KUMOSS_NOTIFICATIONS_TOKEN is empty).
KUMOSS_NOTIFICATIONS_TOKEN=dev-notifications-token

# Slack incoming-webhook URL the reference impl posts to. REQUIRED:
# the service refuses to start without it. Treat it as a secret: anyone
# holding it can post to the channel.
SLACK_WEBHOOK_URL=

# Root log level (DEBUG, INFO, WARNING, ERROR). The service itself only
# emits warnings and errors; secrets (webhook URL, token) are never logged.
LOG_LEVEL=INFO
