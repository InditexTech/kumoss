# Nebula notifications service — environment variables.
#
# Copy to ./services/notifications/.env (gitignored). The notifications
# service's env_file: in docker-compose.yml points here.

# Bearer token clients must present. MUST match NEBULA_NOTIFICATIONS_TOKEN
# in core/.env. Empty disables auth on the service side; the core's
# config.yaml is the source of truth for whether a token is required
# (the core refuses to boot if services.notifications.enabled=true but
# the resolved NEBULA_NOTIFICATIONS_TOKEN is empty).
NEBULA_NOTIFICATIONS_TOKEN=

# Slack incoming-webhook URL the reference impl posts to. Treat it as
# a secret: anyone holding it can post to the channel. If left empty the
# service still boots and answers /healthz, but /v1/notify returns
# 503 Service Unavailable (the contract's "running but not configured"
# response) — the core logs a warning and carries on, since
# notifications are fire-and-forget.
SLACK_WEBHOOK_URL=

# Log verbosity of the service's own logger (DEBUG, INFO, WARNING, ...).
# INFO (default) logs the startup configuration summary, every received
# delivery with its id, and every Slack outcome. DEBUG also logs the
# rendered Slack payload. Secrets (webhook URL, token) are never logged.
LOG_LEVEL=INFO
