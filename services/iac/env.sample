# Nebula IaC service — environment variables.
#
# Copy to ./services/iac/.env (gitignored). The IaC
# service's env_file: in docker-compose.yml points here.

# Bearer token clients must present. MUST match NEBULA_IAC_TOKEN
# in core/.env. Empty disables auth on the service side; the core's
# config.yaml is the source of truth for whether a token is required
# (the core refuses to boot if services.iac.enabled=true but the
# resolved NEBULA_IAC_TOKEN is empty).
NEBULA_IAC_TOKEN=

# Name or absolute path of the terraform CLI to invoke. The default
# resolves `terraform` from PATH, which is correct for the bundled
# image. Override only if you ship a non-standard binary location.
TERRAFORM_BINARY=terraform

# Seconds a finished (succeeded/failed) job stays pollable at
# GET /v1/jobs/{job_id} before it is forgotten (polls then return 404).
# Jobs are kept in memory only, so a service restart also forgets them.
NEBULA_IAC_JOB_TTL=3600

# Log level for structured logging output.
LOG_LEVEL=INFO

# === Cloud CLI credentials (startup login) ===
# When set, the service logs into cloud providers at startup so
# terraform commands inherit valid sessions. Missing vars skip that
# provider.

ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_TENANT_ID=
ARM_SUBSCRIPTION_ID=
# Optional: storage account access key for the azurerm backend.
# Use when the service principal does not have Storage Blob Data
# Contributor on the state storage account.
ARM_ACCESS_KEY=

GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CREDENTIALS=
# Optional: impersonate a different service account for GCS backend
# state access. The active SA must have Token Creator on the target.
GOOGLE_BACKEND_IMPERSONATE_SERVICE_ACCOUNT=

AWS_ACCESS_KEY_ID=
# Required alongside AWS_ACCESS_KEY_ID for AWS operations.
AWS_SECRET_ACCESS_KEY=
# Default region for AWS operations including S3 backend.
AWS_DEFAULT_REGION=
AWS_PROFILE=

# AWS cross-account role assumption.  When set, scope-resource-ids for
# AWS constructs arn:aws:iam::{scope_id}:role/{role_name} and assumes
# it via STS, enabling cross-account resource listing.
AWS_TERRAFORM_ROLE_NAME=

# Relative path (within the workspace) to a backend configuration file.
# When set, terraform init receives -backend-config=<path>.
# Leave empty to use the backend block from the HCL code directly.
TF_BACKEND_CONFIG=

# Minutes between cloud CLI re-logins. Tokens are refreshed lazily
# before cloud-dependent operations when the interval has elapsed.
CLOUD_LOGIN_REFRESH_MIN=45
