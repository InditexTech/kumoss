# Kumoss IaC service — environment variables.
#
# Copy to ./services/iac/.env (gitignored). The IaC
# service's env_file: in docker-compose.yml points here.

# Bearer token clients must present. MUST match KUMOSS_IAC_TOKEN
# in core/.env. Empty disables auth on the service side, but the core
# always requires a token for this service — it is mandatory and
# cannot be switched off — so the core refuses to boot when the
# resolved KUMOSS_IAC_TOKEN is empty.
KUMOSS_IAC_TOKEN=dev-iac-token

# === IaC engine selection ===
# Name or absolute path of the IaC engine CLI the service invokes.
# The bundled image ships both engines, so this is purely a runtime
# switch:
#
#   Use OpenTofu (default):  leave IAC_BINARY unset, or IAC_BINARY=tofu
#   Use Terraform:           IAC_BINARY=terraform (BUSL-1.1; your use
#     of it is subject to its license terms)
#
# Any Terraform-compatible engine works; the service only needs
# init/validate/plan/show/apply.
IAC_BINARY=tofu

# === Terraform state backend ===
# Unset (the default), where the engine keeps state is entirely the
# caller's business: `init` uses the backend the workspace's own
# configuration declares
#
# Set it to take that decision over: `init` then runs with
# `-backend-config=<path>` against the backend configuration file
# (.hcl / .tfbackend) at this path — absolute for a file mounted into
# this container, or relative to the workspace for one the target
# repository carries. Not checked at startup: a wrong path fails on
# `init`, in that job's stderr.
#
# IAC_BACKEND_CONFIG=

# === Cloud provider credentials ===
# Add the `ARM_*`, `AWS_*`, `GOOGLE_*`, `OCI_*`/`TF_VAR_*` or `VSPHERE_*`
# variables your modules need below. The IaC engine's providers read them
# directly when running `init` / `plan` / `apply` / `import` — the
# variables are identical for OpenTofu and Terraform. When none are
# set, those commands run anyway and the engine's own authentication
# errors surface in the job result's `stderr`.
#
# AWS: `AWS_REGION` (or `AWS_DEFAULT_REGION`) is required. Before each
# of those four commands the service checks with STS that its
# credentials belong to the request's account, and it is the region of
# generated code whose provider block sets none.
#
# `/v1/import/scope-resource-ids` reads the same variables itself,
# through the clouds' official auth libraries, to query Azure Resource
# Graph, GCP Cloud Asset Inventory or AWS Resource Explorer. Two extra
# requirements apply to it only:
#
#   AWS: Resource Explorer must be enabled for the account
#        (aggregator index + default view).
#   GCP: `cloudasset.googleapis.com` and
#        `cloudresourcemanager.googleapis.com` must be enabled.
#
# See "Import discovery" in README.md.
#
# Which ones to set depends on the cloud and the authentication method:
#
#   PROVIDERS.md       the minimum set per cloud and per auth method
#                      (SPN, OIDC, managed identity, named profile,
#                      local CLI login, ...), plus the state backend
#                      minimums for azurerm / s3 / gcs.
#   FULL_PROVIDERS.md  every variable each provider and backend reads,
#                      grouped by auth method, with its purpose.
#
# The service passes its WHOLE environment to the engine (no
# allowlist), so everything in this file — the bearer token included —
# is visible to provider plugins and to any external/local-exec code in
# the repositories you run. Keep only what the engine needs here.
#
# --- Examples (fake values) ------------------------------------------
# Uncomment the block for each cloud this deployment serves. Never set
# the scope variable (ARM_SUBSCRIPTION_ID, GOOGLE_PROJECT,
# TF_VAR_compartment_ocid, TF_VAR_aws_account_id): each request
# injects it from its `scope_id`. A key file must be mounted into the
# container (add a read-only volume to the `iac` service in
# docker-compose.yml); a path on the host is not visible here.
#
# Azure — service principal with a client secret:
# ARM_TENANT_ID=00000000-0000-0000-0000-000000000000
# ARM_CLIENT_ID=11111111-1111-1111-1111-111111111111
# ARM_CLIENT_SECRET=example~client~secret
#
# AWS — static access keys (serves only the account they belong to):
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=example/secret/access/key/xxxxxxxxxxxxxxx
# AWS_REGION=eu-west-1
# Temporary/SSO credentials only (an empty value breaks the static keys):
# AWS_SESSION_TOKEN=IQoJb3JpZ2luX2VjEXAMPLE...
#
# GCP — service account key file:
# GOOGLE_APPLICATION_CREDENTIALS=/etc/kumoss/creds/gcp-sa.json
# GOOGLE_REGION=europe-west1  # optional default region
#
# OCI — API key (the private key file mounted into the container):
# TF_VAR_tenancy_ocid=ocid1.tenancy.oc1..aaaaaaaaexampletenancy
# TF_VAR_user_ocid=ocid1.user.oc1..aaaaaaaaexampleuser
# TF_VAR_fingerprint=12:34:56:78:90:ab:cd:ef:12:34:56:78:90:ab:cd:ef
# TF_VAR_private_key_path=/etc/kumoss/creds/oci_api_key.pem
# TF_VAR_region=eu-frankfurt-1
#
# VMware vSphere — vCenter service account (not administrator@vsphere.local):
# VSPHERE_SERVER=vcenter.example.internal
# VSPHERE_USER=svc-kumoss@vsphere.local
# VSPHERE_PASSWORD=example-password
# VSPHERE_ALLOW_UNVERIFIED_SSL=true   # lab vCenter with a self-signed cert only
