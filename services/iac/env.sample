# Nebula IaC service — environment variables.
#
# Copy to ./services/iac/.env (gitignored). The IaC
# service's env_file: in docker-compose.yml points here.

# Bearer token clients must present. MUST match NEBULA_IAC_TOKEN
# in core/.env. Empty disables auth on the service side; the core's
# config.yaml is the source of truth for whether a token is required
# (the core refuses to boot if services.iac.enabled=true but the
# resolved NEBULA_IAC_TOKEN is empty).
NEBULA_IAC_TOKEN=

# Name or absolute path of the IaC engine CLI to invoke. The bundled
# image ships both OpenTofu and Terraform, so set `tofu` (the default)
# or `terraform`; any Terraform-compatible binary on PATH or at an
# absolute path also works. No rebuild is needed to switch.
IAC_BINARY=tofu

# Seconds a finished (succeeded/failed) job stays pollable at
# GET /v1/jobs/{job_id} before it is forgotten (polls then return 404).
# Jobs are kept in memory only, so a service restart also forgets them.
NEBULA_IAC_JOB_TTL=3600

# Seconds a single engine command (init/plan/apply/...) may run before
# the job fails with a 504 error and the process is killed. 0 disables.
NEBULA_SUBPROCESS_TIMEOUT=2700

# Log level for structured logging output. WARNING: at DEBUG every
# engine stdout/stderr line (plan/apply output, provider diagnostics)
# is written to the log; keep INFO in shared environments.
LOG_LEVEL=INFO

# === Cloud CLI credentials (startup login) ===
# The service itself logs into every provider whose credentials below
# are COMPLETE, at startup and again every CLOUD_LOGIN_REFRESH_MIN
# minutes, so engine commands and the cloud CLIs inherit valid sessions.
#   - A provider with no credentials is skipped (info log).
#   - A provider with credentials whose login FAILS aborts startup:
#     the service does not come up until the credential is fixed.
# Every job carries a scope_id (required by the contract) and needs at
# least one provider configured here, otherwise it fails with a 422
# error (see README, "Cloud credentials and scope_id").

# Azure service principal — all three required to enable `az login`.
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_TENANT_ID=
# Engine pass-through only: storage account access key for the azurerm
# backend, when the service principal lacks Storage Blob Data
# Contributor on the state storage account.
ARM_ACCESS_KEY=

# GCP service-account key: a file path OR the key JSON inline. Either
# enables `gcloud auth activate-service-account`.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CREDENTIALS=
# Engine pass-through only: impersonate a different service account for
# GCS backend state access. The active SA needs Token Creator on it.
GOOGLE_BACKEND_IMPERSONATE_SERVICE_ACCOUNT=

# AWS ambient credentials. There is no login step; the engine and the
# `aws` CLI read them directly. AWS_ACCESS_KEY_ID being set is the ONLY
# thing the service checks to mark AWS as a configured provider for
# scope_id handling — a profile alone (AWS_PROFILE without a key id)
# is not detected, and jobs then fail with 422 unless another provider
# is configured.
AWS_ACCESS_KEY_ID=
# Engine / aws CLI pass-through only (not read by the service), but
# required by them whenever AWS_ACCESS_KEY_ID is set.
AWS_SECRET_ACCESS_KEY=
# Engine / aws CLI pass-through only (not read by the service).
AWS_DEFAULT_REGION=
AWS_PROFILE=

# AWS cross-account role assumption.  When set, jobs and scope-resource-ids
# that carry an AWS account id as scope_id construct
# arn:aws:iam::{scope_id}:{AWS_TERRAFORM_ROLE_NAME} and assume it via STS.
# The value is the IAM *resource path*, so it MUST include the "role/"
# prefix (and any path segments), e.g. "role/nebula-terraform" or
# "role/ci/nebula-terraform" — the service does not add it for you.
# Cross-cloud plans are not supported: with Azure/GCP credentials also
# configured, an Azure/GCP scope_id still triggers an AssumeRole attempt
# that fails; that failure is ignored and the job continues.
AWS_TERRAFORM_ROLE_NAME=

# Relative path (within the workspace) to a backend configuration file.
# When set, terraform init receives -backend-config=<path>.
# Leave empty to use the backend block from the HCL code directly.
TF_BACKEND_CONFIG=

# Minutes between cloud CLI re-logins. Tokens are refreshed lazily by
# the next job once the interval has elapsed.
CLOUD_LOGIN_REFRESH_MIN=45

# A re-login that fails is retried this many times (only the providers
# that failed), with exponential backoff starting at
# CLOUD_LOGIN_RETRY_DELAY_SEC seconds (2s, 4s, 8s by default). Only if
# every retry fails does the job fail (500); the following job tries
# again. Startup never retries: a broken credential aborts boot.
CLOUD_LOGIN_RETRIES=3
CLOUD_LOGIN_RETRY_DELAY_SEC=2
