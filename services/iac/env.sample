# Nebula IaC service — environment variables.
#
# Copy to ./services/iac/.env (gitignored). The IaC
# service's env_file: in docker-compose.yml points here.

# Bearer token clients must present. MUST match NEBULA_IAC_TOKEN
# in core/.env. Empty disables auth (local-dev only).
NEBULA_IAC_TOKEN=

# === Terraform provider credentials ===
# The IaC reference impl runs `terraform plan` against your
# cloud accounts using these. Skipped (with a clear note in the
# response) when none are set.

ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_TENANT_ID=
ARM_SUBSCRIPTION_ID=

GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CREDENTIALS=

AWS_ACCESS_KEY_ID=
AWS_PROFILE=
