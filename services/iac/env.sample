# Nebula IaC service — environment variables.
#
# Copy to ./services/iac/.env (gitignored). The IaC
# service's env_file: in docker-compose.yml points here.

# Bearer token clients must present. MUST match NEBULA_IAC_TOKEN
# in core/.env. Empty disables auth on the service side; the core's
# config.yaml is the source of truth for whether a token is required
# (the core refuses to boot if services.iac.enabled=true but the
# resolved NEBULA_IAC_TOKEN is empty).
NEBULA_IAC_TOKEN=

# === IaC engine selection ===
# Name or absolute path of the IaC engine CLI the service invokes.
# The bundled image ships OpenTofu, so the default (`tofu`) needs no
# override.
#
#   Use OpenTofu (default):  leave IAC_BINARY unset, or IAC_BINARY=tofu
#   Use Terraform:           IAC_BINARY=terraform — and ship a real
#     terraform binary in your image. In the bundled image `terraform`
#     is a symlink to `tofu`, so running genuine HashiCorp Terraform
#     requires a custom image that installs it (subject to HashiCorp's
#     BUSL license terms). Any Terraform-compatible engine works; the
#     service only needs init/validate/plan/show/apply/import/state.
#
# TERRAFORM_BINARY (deprecated) is still honored when IAC_BINARY is
# unset, so existing .env files keep working; it will be removed in a
# future release.
IAC_BINARY=tofu

# Seconds a finished (succeeded/failed) job stays pollable at
# GET /v1/jobs/{job_id} before it is forgotten (polls then return 404).
# Jobs are kept in memory only, so a service restart also forgets them.
NEBULA_IAC_JOB_TTL=3600

# === Cloud provider credentials ===
# The IaC engine's providers read these directly when running `plan` /
# `apply` / `import` — the variables are identical for OpenTofu and
# Terraform. When none are set, those commands run anyway and the
# engine's own authentication errors surface in the job result's
# `stderr`.

ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_TENANT_ID=
ARM_SUBSCRIPTION_ID=

GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CREDENTIALS=

AWS_ACCESS_KEY_ID=
AWS_PROFILE=
