# Kumoss LLM sidecar — environment variables.
#
# Copy to ./services/llm/.env (gitignored). The llm service's env_file:
# in docker-compose.yml points here. This container owns LiteLLM, so the
# LLM (and hosted web-search) provider credentials live here, not in
# core/.env.

# Bearer token clients must present. MUST match KUMOSS_LLM_TOKEN in
# core/.env. Empty disables the check on the service side (local
# experimentation only); once set, the values must match exactly.
KUMOSS_LLM_TOKEN=dev-llm-token

# Path of the config.yaml whose `llm` and `web_search` sections this
# service reads (the same file the core reads). Defaults to
# /etc/kumoss/config.yaml; a missing file means built-in defaults.
# KUMOSS_CONFIG=/etc/kumoss/config.yaml

# === LLM provider credentials ===
# config.yaml's llm.model / llm.small_model pick the models; credentials
# are read from the provider's standard LiteLLM env vars. The service
# refuses to start when litellm reports a required variable missing. See
#   https://inditextech.github.io/kumoss/stable/main/reference/llm-providers/
# for the per-provider variable names:
# Vertex AI example:
# VERTEXAI_PROJECT=your_gcp_project_id
# VERTEXAI_LOCATION=your_gcp_region
# VERTEXAI_CREDENTIALS=your_service_account_json
# Anthropic example:
# ANTHROPIC_API_KEY=
# Refer to:
#   - https://inditextech.github.io/kumoss/stable/main/reference/llm-providers/  — Kumoss's LiteLLM guide
#   - https://docs.litellm.ai/docs/providers                                         — provider credential keys

# On prem model key (adapt this name to the one used in the config.yaml,
# e.g. an `os.environ/ONPREM_LLM_MODEL_KEY` reference in llm.model_list)
ONPREM_LLM_MODEL_KEY=

# === Web search provider credentials ===
# Only for hosted web_search.provider values (tavily, brave, perplexity,
# ...); the bundled SearXNG needs none. Use the provider's standard
# LiteLLM env var, e.g.:
# TAVILY_API_KEY=
