# Nebula mapping service — environment variables.
#
# Copy to ./services/mapping/.env (gitignored). The mapping service's
# env_file: in docker-compose.yml points here.

# Bearer token clients must present. MUST match NEBULA_MAPPING_TOKEN in
# core/.env. Empty disables auth (local-dev only).
NEBULA_MAPPING_TOKEN=

# CORS origins the browser may use to call this service directly.
# Mapping is the one Nebula service called from the React app (not via
# the api proxy), so its CORS list matters. The proxy serves the
# frontend on http://localhost.
NEBULA_MAPPING_CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80
