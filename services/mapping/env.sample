# Nebula mapping service — environment variables.
#
# Copy to ./services/mapping/.env (gitignored). The mapping service's
# env_file: in docker-compose.yml points here.

# Bearer token clients must present. MUST match NEBULA_MAPPING_TOKEN in
# core/.env. Empty disables auth on the service side; the core's
# config.yaml is the source of truth for whether a token is required
# (the core refuses to boot if services.mapping.enabled=true but the
# resolved NEBULA_MAPPING_TOKEN is empty).
NEBULA_MAPPING_TOKEN=
