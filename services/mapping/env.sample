# Kumoss mapping service — environment variables.
#
# Copy to ./services/mapping/.env (gitignored). The mapping service's
# env_file: in docker-compose.yml points here.

# Bearer token clients must present. MUST match KUMOSS_MAPPING_TOKEN in
# core/.env. Empty disables auth on the service side; the core's
# config.yaml is the source of truth for whether a token is required
# (the core refuses to boot if services.mapping.enabled=true but the
# resolved KUMOSS_MAPPING_TOKEN is empty).
KUMOSS_MAPPING_TOKEN=dev-mapping-token

# Base URL a bare repository name is appended to. With
# https://github.com/my-org/ the identifier `foo` resolves to
# https://github.com/my-org/foo.git (a trailing `/` is added if missing).
# Must be https://, without a password, query or fragment. Leave empty
# to resolve full https:// repository URLs only; bare names then answer
# 404.
MAPPING_PREFIX_IDENTIFIER=

# Python logging level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
