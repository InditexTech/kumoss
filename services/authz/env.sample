# Nebula authz service — environment variables.
#
# Copy to ./services/authz/.env (gitignored). The authz service's
# env_file: in docker-compose.yml points here.

# Bearer token clients must present. MUST match NEBULA_AUTHZ_TOKEN in
# core/.env. Empty disables auth on the service side; the core's
# config.yaml is the source of truth for whether a token is required
# (the core refuses to boot if services.authz.enabled=true but the
# resolved NEBULA_AUTHZ_TOKEN is empty).
NEBULA_AUTHZ_TOKEN=

# When set, the user with this email is granted the `admin` role on
# startup. After bootstrap, manage roles via the /v1/users admin
# endpoints. Leave empty to disable bootstrap.
NEBULA_AUTHZ_ROOT_ADMIN_EMAIL=

# Permissive default returns authorized=true unconditionally. Set false
# to flip the default to authorized=false (the OSS reference impl has
# no built-in cloud-access check; flipping makes misconfigurations
# visible).
NEBULA_AUTHZ_PERMISSIVE=true

# Path inside the container where the JSON role store lives. This path
# is container-local, so role assignments are lost when the container is
# recreated; point it at a mounted path to keep them.
NEBULA_AUTHZ_ROLE_STORE=/data/roles.json
