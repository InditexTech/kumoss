# Kumoss SearXNG service — environment variables.
#
# Copy to ./services/searxng/.env (gitignored). The searxng service's
# env_file: in docker-compose.yml points here.

# SearXNG instance secret key, used for cryptography (e.g. signed
# encrypted cookies). The docker entrypoint substitutes it into
# settings.yml's server.secret_key via the ${SEARXNG_SECRET} placeholder.
# REQUIRED in production: generate one with
#   openssl rand -base64 32
# Leaving it unset makes the container generate a random key at every
# start — fine for a throwaway local stack (signed keys reset when the
# container restarts), never for a reachable deployment.
SEARXNG_SECRET=
