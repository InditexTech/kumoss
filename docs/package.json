{
  "name": "nebula",
  "version": "0.1.0",
  "private": true,
  "description": "Nebula documentation, built with Antora",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "build": "antora --fetch antora-playbook.yml",
    "dev": "docouture dev",
    "clean": "node -e \"require('fs').rmSync('build', { recursive: true, force: true })\"",
    "check-links": "node scripts/check-links.mjs"
  },
  "devDependencies": {
    "@inditextech/docouture-cli": "1.1.1",
    "@inditextech/docouture-ui-bundle": "1.1.1",
    "@inditextech/docouture-asciidoc-extensions": "1.1.1",
    "@inditextech/docouture-antora-extensions": "1.1.1",
    "@inditextech/docouture-publish-gh-pages": "1.1.1",
    "antora": "3.2.0",
    "linkinator": "8.0.4"
  },
  "docouture": {
    "branching": "trunk-based",
    "publish": {
      "gh-pages": {}
    },
    "checkLinks": {
      "ignore": [
        "*/edit/HEAD/*",
        "https://<org>.github.io/<repo>",
        "https://github.com/InditexTech/nebula",
        "https://github.com/InditexTech/nebula/issues*",
        "https://github.com/InditexTech/nebula/pulls*"
      ]
    }
  }
}
