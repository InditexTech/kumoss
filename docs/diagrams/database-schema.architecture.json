  "cards": [
    {
      "dot": "cyan",
      "title": "Keys",
      "items": [
        "Every table: id, created_at, updated_at",
        "A child's foreign key is <parent>_id, indexed",
        "users unique on (issuer, subject)",
        "rounds unique on (session_id, number)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Ownership",
      "items": [
        "One chain: users to sessions to rounds",
        "statuses hang off both a session and a round",
        "artifacts are shared, never session-scoped"
      ]
    },
    {
      "dot": "amber",
      "title": "Lifecycle",
      "items": [
        "Cascades live in the ORM, not in the DDL",
        "Dashed: the one link that does not cascade",
        "No migrations; the schema comes from create_all"
      ]
    }
  ]
