      "label": ":9000 presigned GET"
    },
    {
      "id": "jwks-fetch",
      "from": "core-api",
      "to": "idp",
      "label": "discovery + JWKS",
      "variant": "dashed",
      "labelDy": -30
    },
    {
      "id": "api-to-core",
      "from": "core-api",
      "to": "core-infra",
      "label": "ports to adapters"
    },
    {
      "id": "completions",
      "from": "core-infra",
      "to": "llm",
      "label": "HTTPS completions",
      "labelDy": -68
    },
    {
      "id": "git-push",
      "from": "core-infra",
      "to": "githost",
      "label": "push + PR REST",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "id": "call-sidecars",
      "from": "core-infra",
      "to": "sidecars",
      "label": "REST + bearer"
    },
    {
      "id": "artifacts",
      "from": "core-infra",
      "to": "storage",
      "label": "put + presign"
    },
    {
      "id": "sessions-sql",
      "from": "core-infra",
      "to": "coredb",
      "label": "SQL via asyncpg",
      "labelDy": 24
    },
    {
      "id": "traces",
      "from": "core-infra",
      "to": "phoenix",
      "label": "OTLP + prompts"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Edge and identity",
      "items": [
        "Nginx is the only container publishing host ports, and it builds and serves the SPA",
        "Every /v1 route except GET /v1/auth/config requires a bearer token",
        "A blank oidc.issuer_url disables auth and resolves a fixed dev identity"
      ]
    },
    {
      "dot": "emerald",
      "title": "Core layers and sidecars",
      "items": [
        "API to application to domain to adapters, wired by ApplicationFactory",
        "authz :8083, mapping :8081, iac :8082 and notifications :8080 each own an OpenAPI contract",
        "core and iac share the workspaces volume, so the engine runs on the core's git clones"
      ]
    },
    {
      "dot": "amber",
      "title": "State and configuration",
      "items": [
        "Roles and sessions live in core-db, not in the authz sidecar",
        "Redis 8 backs the read-through cache in front of core-db",
        "storage.provider selects RustFS, AWS S3 or an Azure Storage Account",
        "Dashed edges exist in code but are not exercised by the checked-in config.yaml"
      ]
    }
  ]
}
