  "boundaries": [
    {
      "kind": "region",
      "label": "Compose project kumoss, one bridge network",
      "wraps": [
        "iac",
        "notifications",
        "objectstorage",
        "redis",
        "core",
        "coredb",
        "phoenix",
        "proxy"
      ]
    }
  ],
  "connections": [
    {
      "id": "user-to-proxy",
      "from": "user",
      "to": "proxy",
      "label": ":80 and :9000"
    },
    {
      "id": "proxy-to-core",
      "from": "proxy",
      "to": "core",
      "label": "/api + SSE"
    },
    {
      "id": "proxy-to-phoenix",
      "from": "proxy",
      "to": "phoenix",
      "label": "/monitoring/"
    },
    {
      "id": "core-to-notifications",
      "from": "core",
      "to": "notifications",
      "label": "fire-and-forget"
    },
    {
      "id": "core-to-iac",
      "from": "core",
      "to": "iac",
      "label": "engine jobs"
    },
    {
      "id": "core-to-storage",
      "from": "core",
      "to": "objectstorage",
      "label": "artifacts"
    },
    {
      "id": "core-to-coredb",
      "from": "core",
      "to": "coredb",
      "label": "asyncpg"
    },
    {
      "id": "core-to-redis",
      "from": "core",
      "to": "redis",
      "label": "cache"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Published surface",
      "items": [
        "Only proxy publishes host ports: :80 for SPA, API, SSE and /monitoring/, :9000 for presigned URLs",
        "Every other container is internal-only via expose",
        "core calls the LLM and git APIs; notifications posts to the Slack webhook"
      ]
    },
    {
      "dot": "emerald",
      "title": "The shared workspaces volume",
      "items": [
        "core and iac mount workspaces read-write, so the engine runs on the core git clones",
        "Both run as kumoss, uid/gid 10001 via KUMOSS_UID and KUMOSS_GID",
        "Each run clones into a unique directory and deletes it in a finally block"
      ]
    },
    {
      "dot": "amber",
      "title": "Persistence and start-up",
      "items": [
        "Named volumes: core_db_data, phoenix_db_data, object_storage_data, workspaces",
        "No authz or mapping container: those optional contracts are off and core answers locally",
        "depends_on orders start-up without health checks; the prompt seeder retries phoenix"
      ]
    }
  ]
}
