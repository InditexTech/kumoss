%% What you deploy — core platform components (run as shipped) versus the four
%% replaceable sidecars (OpenAPI contracts). Source for docs/images/readme-components.png.
flowchart TB
  browser["👤 Browser"]

  subgraph core["Core platform components — run as shipped"]
    direction LR
    proxy["proxy<br/>web app, API, monitoring"]
    coreapi["core<br/>orchestration API"]
    coredb[("core-db<br/>sessions, users, roles")]
    redis[("redis<br/>cache")]
    objstore[("object-storage<br/>artifacts, optional state")]
    phoenix["phoenix<br/>observability, prompts"]
  end

  subgraph sidecars["Sidecars — OpenAPI contracts, replaceable"]
    direction LR
    iac["iac · mandatory<br/>OpenTofu / Terraform"]
    notif["notifications · disabled<br/>Slack"]
    mapping["mapping · disabled<br/>repository routing"]
    authz["authz · disabled<br/>authorization policy"]
  end

  subgraph org["Your organization"]
    direction LR
    llm["LLM providers"]
    git["Git hosting"]
    cloud["Cloud accounts"]
    slack["Slack"]
  end

  browser --> proxy
  proxy --> coreapi
  proxy -.-> phoenix
  coreapi --> coredb
  coreapi --> redis
  coreapi --> objstore
  coreapi --> phoenix
  coreapi ==> iac
  coreapi -.-> notif
  coreapi -.-> mapping
  coreapi -.-> authz
  coreapi --> llm
  coreapi --> git
  iac --> cloud
  notif -.-> slack

  %% invisible edges: keep the sidecar band below the core band
  coredb ~~~ iac
  objstore ~~~ mapping
  phoenix ~~~ authz

  classDef corestyle fill:#e6f4ea,stroke:#2e7d32,color:#1b1b1b
  classDef sidecar fill:#fff4e5,stroke:#e65100,color:#1b1b1b
  classDef optional fill:#fff4e5,stroke:#e65100,stroke-dasharray:5 4,color:#1b1b1b
  classDef ext fill:#f3f3f3,stroke:#616161,color:#1b1b1b
  classDef user fill:#e3f2fd,stroke:#1565c0,color:#1b1b1b
  class proxy,coreapi,coredb,redis,objstore,phoenix corestyle
  class iac sidecar
  class notif,mapping,authz optional
  class llm,git,cloud,slack ext
  class browser user
  style core fill:#f7fbf8,stroke:#2e7d32,stroke-dasharray:6 4
  style sidecars fill:#fffaf3,stroke:#e65100,stroke-dasharray:6 4
  style org fill:#fafafa,stroke:#9e9e9e,stroke-dasharray:6 4
