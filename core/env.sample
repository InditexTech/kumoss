# Kumoss core (api) — environment variables.
#
# Copy to ./core/.env (gitignored) and fill in. The api service's
# env_file: in docker-compose.yml points at ./core/.env, so this file is
# the api container's source of truth for everything env-driven.
#
# The KUMOSS_*_TOKEN values must MATCH the value set in each
# matching service's own .env (services/<svc>/.env). The api uses them
# as outbound bearer tokens; each service uses them to validate the
# incoming Authorization header.

# === LLM provider credentials ===
# None here: the LLM sidecar (services/llm) owns LiteLLM, so provider
# credentials (ANTHROPIC_API_KEY, VERTEXAI_*, ...) and hosted web-search
# keys go in services/llm/.env. See services/llm/env.sample and
#   https://inditextech.github.io/kumoss/stable/main/reference/llm-providers/
# Every variable in this file is documented at
#   https://inditextech.github.io/kumoss/stable/main/reference/environment-variables/

# === Service bearer tokens ===
# Generate with e.g. `openssl rand -hex 32`. Must MATCH the value set in
# each matching service's own .env (services/<svc>/.env). The value MUST
# be non-empty: the core refuses to boot when a service it calls has no
# token (KUMOSS_IAC_TOKEN and KUMOSS_LLM_TOKEN always; the others only
# when their service is enabled in config.yaml). The bundled services
# skip the check only while their own token variable is empty; once set
# there, the values must match exactly. For an isolated local stack a
# placeholder such as `dev-token` is acceptable.
KUMOSS_NOTIFICATIONS_TOKEN=dev-notifications-token
KUMOSS_IAC_TOKEN=dev-iac-token
KUMOSS_LLM_TOKEN=dev-llm-token
# Only when you enable your own mapping / authz implementation in
# config.yaml (services.mapping / services.authz); Kumoss bundles neither.
# KUMOSS_MAPPING_TOKEN=
# KUMOSS_AUTHZ_TOKEN=

# === Authentication (OIDC) ===
# Nothing to set here. OIDC login is configured in config.yaml (oidc.issuer_url,
# oidc.client_id, optional oidc.audience / oidc.scope, admin.default_root_email)
# and involves no secret: the SPA is a public PKCE client and the core only
# needs the issuer's public JWKS. A blank oidc.issuer_url (the default)
# disables auth entirely — every request runs as a local dev admin. See
#   https://inditextech.github.io/kumoss/stable/main/guides/enable-authentication/

# === Git push credentials (matches system_config.git.pat_*_env) ===
# Used at boot to write ~/.git-credentials so `git push` authenticates
# without prompting, and by the pull-request REST calls. Leave empty to
# skip; push then needs a pre-mounted ~/.git-credentials, but
# pull-request creation and merge still require GIT_TOKEN. Repository
# URLs must be https:// on github.com, gitlab.com, or dev.azure.com;
# SSH and other schemes, and URLs with an embedded password or token,
# are rejected by the API.
GIT_USER=
GIT_TOKEN=

# === Object storage credentials (matches system_config.storage.*_env) ===
# Must MATCH the credentials of the object-storage service. The bundled
# docker-compose.yml sets none, so RustFS uses its built-in rustfsadmin /
# rustfsadmin; if you set RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY there,
# mirror them here. For storage.provider: S3, BLANK both lines (a non-empty value
# is sent to AWS as static keys) so boto3 uses its default credential
# chain (IAM role etc.).
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# For storage.provider: STORAGE_ACCOUNT — shared key of the Azure
# storage account (Portal → storage account → Access keys). Required at
# boot when STORAGE_ACCOUNT is selected; the key also signs the SAS
# download URLs. The account name comes from storage.endpoint_url in
# config.yaml, not from env.
# STORAGE_ACCOUNT_KEY=

# === Kumoss Postgres URL ===
KUMOSS_SQL_DATABASE_URL=postgresql://postgres:postgres@core-db:5432/kumoss
