# Nebula core (api) — environment variables.
#
# Copy to ./core/.env (gitignored) and fill in. The api service's
# env_file: in docker-compose.yml points at ./core/.env, so this file is
# the api container's source of truth for everything env-driven.
#
# The four NEBULA_*_TOKEN values must MATCH the value set in each
# matching service's own .env (services/<svc>/.env). The api uses them
# as outbound bearer tokens; each service uses them to validate the
# incoming Authorization header.

# === LLM provider credentials ===
# Pick one provider. See examples/config.yaml for the YAML knobs that
# decide which provider/model the core actually uses.

# --- Anthropic-on-Vertex / Google Vertex (the OSS-default) ---
GOOGLE_VERTEX_ID=
GOOGLE_APPLICATION_CREDENTIALS=/usr/src/app/gcp-credentials.json
GOOGLE_SA_SECRET=

# --- Anthropic-on-Bedrock (alternative) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# === Service bearer tokens ===
# Generate with e.g. `openssl rand -hex 32`. Must MATCH the value set in
# each matching service's own .env (services/<svc>/.env). The value MUST
# be non-empty — the generated clients always send `Authorization:
# Bearer <token>` and httpx rejects an empty bearer as a malformed
# header, crashing the request before it leaves the api container. For
# local dev the bundled services accept any non-empty string by default;
# `dev-token` is a safe placeholder.
NEBULA_NOTIFICATIONS_TOKEN=dev-notifications-token
NEBULA_MAPPING_TOKEN=dev-mapping-token
NEBULA_IAC_TOKEN=dev-iac-token
NEBULA_AUTHZ_TOKEN=dev-authz-token

# === Git push credentials (matches system_config.git.pat_*_env) ===
# Used at boot to write ~/.git-credentials so `git push` authenticates
# without prompting. Leave empty to skip (push will fall back to SSH keys,
# a pre-mounted ~/.git-credentials, or a PAT-embedded repo_uri).
GIT_USER=
GIT_TOKEN=

# === Phoenix telemetry (used by the bundled phoenix container) ===
PHOENIX_SQL_DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres
