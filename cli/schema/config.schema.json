{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://inditextech.github.io/kumoss/schema/config.schema.json",
    "title": "Kumoss system config (config.yaml)",
    "description": "Generated by `kumoss init` and mounted into the core at /etc/kumoss/config.yaml. Carries deployment-tunable knobs only; secrets live in env vars named by the *_env keys. Mirrors core/local_test/config.yaml.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "environment": {
            "type": "string",
            "enum": [
                "development",
                "staging",
                "production"
            ],
            "default": "development",
            "description": "Selects the Phoenix tracing project prefix (dev-/pre-/pro-) and the prompt tag. No security gates keyed on it."
        },
        "oidc": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "issuer_url": {
                    "type": "string",
                    "description": "Blank disables auth entirely (dev default: every request is a local developer with top roles)."
                },
                "client_id": {
                    "type": "string"
                },
                "audience": {
                    "type": "string"
                },
                "scope": {
                    "type": "string"
                },
                "clock_skew_seconds": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 60,
                    "description": "Allowed leeway on exp/iat/nbf."
                }
            }
        },
        "admin": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "default_root_email": {
                    "type": "string",
                    "description": "Email claim elevated to the top role on login (requires email_verified). Blank to skip."
                }
            }
        },
        "services": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "notifications": {
                    "$ref": "#/$defs/service"
                },
                "mapping": {
                    "$ref": "#/$defs/service"
                },
                "authz": {
                    "$ref": "#/$defs/service"
                },
                "iac": {
                    "$ref": "#/$defs/iacService"
                }
            }
        },
        "orchestration": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enable_compliance_checker": {
                    "type": "boolean",
                    "default": false,
                    "description": "Audit a validated generate round with a second small-model agent; error/critical findings lock the session."
                },
                "block_on_high_impact": {
                    "type": "boolean",
                    "default": false,
                    "description": "Lock the session when the generate report carries a high impact banner."
                },
                "max_drift_reports": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 3,
                    "description": "Maximum detect-and-remediate iterations in a drift session."
                },
                "max_validation_iteration": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 5
                },
                "max_tool_agent_executions": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 40
                },
                "max_session_events_iteration": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 2160
                },
                "drift_group_operations": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 8
                },
                "pull_request_readiness_seconds": {
                    "type": "number",
                    "minimum": 0,
                    "default": 10
                }
            }
        },
        "llm": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "model",
                "small_model"
            ],
            "properties": {
                "model": {
                    "type": "string",
                    "minLength": 1,
                    "description": "LiteLLM model string for complex tasks (provider/model-id)."
                },
                "small_model": {
                    "type": "string",
                    "minLength": 1,
                    "description": "LiteLLM model string for cheap filler tasks."
                },
                "temperature": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2,
                    "default": 0.1
                },
                "max_output_tokens": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 32000
                },
                "timeout": {
                    "type": "number",
                    "minimum": 0,
                    "default": 600
                },
                "model_list": {
                    "type": "array",
                    "description": "Optional LiteLLM Router list; when present the core passes only this list to the Router.",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "model_name",
                            "litellm_params"
                        ],
                        "properties": {
                            "model_name": {
                                "type": "string",
                                "minLength": 1
                            },
                            "litellm_params": {
                                "type": "object",
                                "required": [
                                    "model"
                                ],
                                "properties": {
                                    "model": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "api_base": {
                                        "type": "string",
                                        "format": "uri"
                                    },
                                    "api_key": {
                                        "type": "string",
                                        "description": "Use os.environ/VAR to reference a credential env var rather than inlining the secret."
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "web_search": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "provider": {
                    "type": "string",
                    "description": "Empty disables the web_search tool. Shipped stack uses searxng.",
                    "default": "searxng"
                },
                "endpoint": {
                    "type": "string",
                    "format": "uri",
                    "default": "http://searxng:8888"
                },
                "timeout": {
                    "type": "number",
                    "minimum": 0,
                    "default": 30.0
                },
                "max_results": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 8
                },
                "max_page_chars": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 10000
                },
                "summarize": {
                    "type": "boolean",
                    "default": true
                },
                "summarize_top": {
                    "type": "integer",
                    "minimum": 1
                },
                "summarize_max_chars": {
                    "type": "integer",
                    "minimum": 1
                },
                "max_query_retries": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "paths": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "upload_folder": {
                    "type": "string",
                    "description": "Must be writable and shared with the iac service via the workspaces volume."
                },
                "session_plan_filename": {
                    "type": "string",
                    "pattern": "^[^/]+$",
                    "description": "Bare filename; keep the .plan suffix so the injected gitignore covers it."
                },
                "backend_override_filename": {
                    "type": "string",
                    "pattern": "^[^/]+_override\\.tf$",
                    "description": "Bare filename ending in _override.tf; Terraform only merges that suffix."
                }
            }
        },
        "database": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "kumoss_database_url_env": {
                    "type": "string",
                    "minLength": 1,
                    "default": "KUMOSS_SQL_DATABASE_URL",
                    "description": "Name of the env var holding the connection URL. The core refuses to boot when it resolves empty."
                }
            }
        },
        "redis": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "redis_url_env": {
                    "type": "string",
                    "default": "KUMOSS_REDIS_URL"
                },
                "default_url": {
                    "type": "string",
                    "format": "uri",
                    "default": "redis://redis:6379/0"
                },
                "max_connections": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 20
                },
                "socket_connect_timeout": {
                    "type": "number",
                    "minimum": 0,
                    "default": 2.0
                },
                "socket_timeout": {
                    "type": "number",
                    "minimum": 0,
                    "default": 2.0
                },
                "pool_timeout": {
                    "type": "number",
                    "minimum": 0,
                    "default": 2.0
                }
            }
        },
        "telemetry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "collector_url": {
                    "type": "string",
                    "format": "uri",
                    "default": "http://phoenix:6006/",
                    "description": "Base URL; the OTLP endpoint is computed as <collector_url>v1/traces."
                },
                "otel_attribute_count_limit": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1024
                },
                "otel_console_exporter": {
                    "type": "boolean",
                    "default": false
                }
            }
        },
        "http": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "cors_origins": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "http://localhost"
                    ]
                }
            }
        },
        "storage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "provider",
                "bucket"
            ],
            "properties": {
                "provider": {
                    "type": "string",
                    "enum": [
                        "RUSTFS",
                        "S3",
                        "STORAGE_ACCOUNT"
                    ],
                    "default": "RUSTFS",
                    "description": "ObjectStorageProvider enum name."
                },
                "bucket": {
                    "type": "string",
                    "minLength": 1,
                    "default": "kumoss-artifacts",
                    "description": "Artifacts bucket."
                },
                "terraform_state_bucket": {
                    "type": "string",
                    "description": "Empty string = repository-declared state; never null (a YAML null fails boot).",
                    "default": "kumoss-terraform-state"
                },
                "terraform_state_filename": {
                    "type": "string",
                    "pattern": "^[^/]+$",
                    "default": "terraform.tfstate",
                    "description": "Bare filename; changing it orphans existing state."
                },
                "endpoint_url": {
                    "type": "string",
                    "format": "uri",
                    "default": "http://object-storage:9000"
                },
                "public_endpoint_url": {
                    "type": "string",
                    "format": "uri",
                    "default": "http://localhost:9000"
                },
                "region": {
                    "type": "string",
                    "description": "Ignored by STORAGE_ACCOUNT."
                },
                "connect_timeout": {
                    "type": "number",
                    "minimum": 0,
                    "default": 3.0
                },
                "read_timeout": {
                    "type": "number",
                    "minimum": 0,
                    "default": 10.0
                },
                "max_attempts": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 3
                },
                "presign_expiry_seconds": {
                    "type": "integer",
                    "minimum": 108000,
                    "maximum": 604800,
                    "default": 172800,
                    "description": "Must outlive the 24h cached session aggregate (>= 30h) and stay under the SigV4 7-day limit."
                }
            }
        },
        "git": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "provider": {
                    "type": "string",
                    "enum": [
                        "GITHUB",
                        "AZURE_DEVOPS",
                        "GITLAB"
                    ],
                    "default": "GITHUB",
                    "description": "GitProviderName enum name or value."
                },
                "author_name": {
                    "type": "string",
                    "default": "Kumoss"
                },
                "author_email": {
                    "type": "string",
                    "format": "email",
                    "default": "kumoss@noreply.invalid"
                }
            }
        }
    },
    "$defs": {
        "service": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": true
                },
                "endpoint": {
                    "type": "string",
                    "format": "uri"
                },
                "token_env": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Env var holding the bearer token. An enabled service whose token resolves empty refuses the core's boot."
                },
                "timeout": {
                    "type": "number",
                    "minimum": 0,
                    "default": 30.0,
                    "description": "Per-request HTTP budget in seconds."
                }
            }
        },
        "iacService": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": true
                },
                "endpoint": {
                    "type": "string",
                    "format": "uri"
                },
                "token_env": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Env var holding the bearer token. An enabled service whose token resolves empty refuses the core's boot."
                },
                "timeout": {
                    "type": "number",
                    "minimum": 0,
                    "default": 30.0
                },
                "job_poll_interval": {
                    "type": "number",
                    "minimum": 0,
                    "default": 5.0
                },
                "job_timeout": {
                    "type": "number",
                    "minimum": 0,
                    "default": 3600.0
                }
            }
        }
    }
}
